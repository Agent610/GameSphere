# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
# `.env` is ignored by Git. Never commit real secrets.

# Port the API listens on.
PORT=3000

# MongoDB connection string (a local install or a MongoDB Atlas URI).
MONGODB_URI=mongodb://127.0.0.1:27017/gamesphere

# Browser origins allowed to call the API, comma-separated.
# 5173 is the default port of the Vite dev server in client/.
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign login tokens. Must be at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters

# How long a login token stays valid (e.g. 1h, 7d).
JWT_EXPIRES_IN=7d

# Optional: login/register attempts allowed per IP address every 15 minutes.
# AUTH_RATE_LIMIT_MAX=20

# Optional: RSS feeds read by GET /api/news, comma-separated. Leave unset to use
# the official PlayStation, Xbox, and Steam blogs. No API key is needed.
# NEWS_FEED_URLS=https://blog.playstation.com/feed/,https://news.xbox.com/en-us/feed/

# Twitch credentials for the IGDB game catalog. These are not an access token.
# The app exchanges them for one with:
#   POST https://id.twitch.tv/oauth2/token?client_id=<TWITCH_CLIENT_ID>&client_secret=<TWITCH_CLIENT_SECRET>&grant_type=client_credentials
# A Client ID of abcdefg12345 and a Client Secret of hijklmn67890 would be:
#   POST https://id.twitch.tv/oauth2/token?client_id=abcdefg12345&client_secret=hijklmn67890&grant_type=client_credentials
# Twitch responds with JSON:
#   { "access_token": "access12345token", "expires_in": 5587808, "token_type": "bearer" }
# expires_in is the number of seconds until access_token must be refreshed.
# Send access_token to IGDB. Do not store that token in this file.
# Create the app at https://dev.twitch.tv/console/apps. Copy the Client ID from
# the app page. The Client Secret is shown once, when you click New Secret.
# Keep real values in server/.env only. This file stays commented out.
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=

# Deployment only: how many proxies sit in front of the app (1 on most hosts).
# Needed for the login rate limit to count each visitor separately.
# TRUST_PROXY=1
