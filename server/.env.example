# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
# `.env` is ignored by Git. Never commit real secrets.

# Port the API listens on.
PORT=3000

# MongoDB connection string (a local install or a MongoDB Atlas URI).
MONGODB_URI=mongodb://127.0.0.1:27017/gamesphere

# Browser origins allowed to call the API, comma-separated.
# 5173 is the default port of the Vite dev server in client/.
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign login tokens. Must be at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters

# How long a login token stays valid (e.g. 1h, 7d).
JWT_EXPIRES_IN=7d

# Optional: login/register attempts allowed per IP address every 15 minutes.
# AUTH_RATE_LIMIT_MAX=20

# Optional: gaming news provider used by GET /api/news.
# Leave empty until a provider is chosen; the endpoint then returns 503.
NEWS_API_URL=
NEWS_API_KEY=
